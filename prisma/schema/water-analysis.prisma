// Water Analysis — два уровня данных по бланкам анализа воды.
//
// Этап 1.A — WaterAnalysisRaw: append-only, immutable. Сырое extraction
// от Claude Vision + Ахантер + filename regex. Никаких enums, никакой
// нормализации единиц/синонимов параметров. Источник правды.
//
// Этап 1.B — WaterAnalysis: derived from raw, перегенерируемое.
// Каноничные параметры, enum WaterSourceType, разобранный адрес.
// normalizationVersion позволяет держать несколько версий нормализации
// параллельно для A/B сравнения.
//
// Embedding column добавится в Этапе 2 отдельной миграцией:
//   ALTER TABLE water_analysis ADD COLUMN embedding vector(1536);
//   CREATE INDEX water_analysis_embedding_hnsw_idx ON water_analysis
//       USING hnsw (embedding vector_cosine_ops);
//
// PII (customerName, customerPhone) при derive raw → WaterAnalysis
// полностью отбрасывается (Variant A, решение 2026-05-06): нет колонок
// customerName*, нет FK на pii.jsonl. Telephone-данные у Аквафор кривые,
// customerName в filenameMeta нечистый — для analytics/RAG не нужны.
// Если в будущем потребуется CRM-bridge с person-level точностью —
// идти через order_number + Bitrix24 join, а не через WaterAnalysis.
//
// См. docs/features/water-analysis.md.

model WaterAnalysisRaw {
    id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

    // Из имени файла (regex, бесплатно)
    orderNumber     String   @unique @map("order_number") @db.VarChar(32)
    sourceFileName  String   @map("source_file_name") @db.VarChar(512)

    // SHA256 hex исходного .docx/.dotx/.pdf файла. Используется для idempotency:
    // если orderNumber+hash совпадает — skip extraction. Если orderNumber совпадает
    // но hash другой — файл переименован/обновлён, alert вручную.
    sourceFileHash  String?  @map("source_file_hash") @db.VarChar(64)

    // filenameMeta: { orderNumber, dealerLocation, customerName, sourceTypeHint, sampleDate }
    filenameMeta    Json     @map("filename_meta")

    // Vision raw output как пришёл от Claude через Flowise chatflow
    visionPayload   Json     @map("vision_payload")
    visionModel     String   @map("vision_model") @db.VarChar(64)
    visionTokensIn  Int      @map("vision_tokens_in")
    visionTokensOut Int      @map("vision_tokens_out")

    // Ахантер raw response, что вернул на rawAddress (или dealerLocation fallback) — old pipeline
    ahunterRawAddress     String?  @map("ahunter_raw_address") @db.VarChar(512)
    ahunterRawResponse    Json?    @map("ahunter_raw_response")
    ahunterDealerResponse Json?    @map("ahunter_dealer_response")

    // === Этап 1.A.5 address-resolution pipeline ===
    // (Этап 1.B остаётся за нормализацией params/units/PDK — другая фаза.)
    // Step 1: TS pre-clean (regex strip phone/parens/tail-noise/typos)
    addressPreCleaned       String?   @map("address_pre_cleaned") @db.VarChar(512)
    addressPreCleanedAt     DateTime? @map("address_pre_cleaned_at")

    // Step 2: Ahunter /cleanse/address (full response для optimization later)
    ahunterCleansed         Json?     @map("ahunter_cleansed")
    ahunterCleansedAt       DateTime? @map("ahunter_cleansed_at")
    ahunterCleansedTier     String?   @map("ahunter_cleansed_tier") @db.VarChar(20)
    ahunterCleansedQuery    String?   @map("ahunter_cleansed_query") @db.VarChar(512)

    // Денормализованные удобные поля (частые query без JSONB digging)
    geoLat                  Float?    @map("geo_lat")
    geoLon                  Float?    @map("geo_lon")
    geoRegion               String?   @map("geo_region") @db.VarChar(64)
    geoCity                 String?   @map("geo_city") @db.VarChar(64)
    geoPretty               String?   @map("geo_pretty") @db.VarChar(512)
    geoLevel                WaterGeoLevel? @map("geo_level")
    geoSource               WaterGeocodeSource? @map("geo_source")

    // PostGIS: GENERATED ALWAYS AS (ST_MakePoint(geo_lon, geo_lat)::geography) STORED.
    // Postgres сам синхронизирует при INSERT/UPDATE из geo_lat/geo_lon.
    // Prisma помечает Unsupported т.к. нативного geography типа в Prisma 7 нет —
    // но колонка работает: для read через raw queries ($queryRaw), для filter
    // через ST_DWithin / ST_Distance / ORDER BY ... <-> в raw SQL.
    geoPoint                Unsupported("geography(Point, 4326)")? @map("geo_point")

    // AI verification (Claude review verdict)
    aiVerified              WaterAddressVerification? @map("ai_verified")
    aiVerifiedAt            DateTime? @map("ai_verified_at")
    aiVerifiedNotes         String?   @map("ai_verified_notes") @db.VarChar(512)

    extractedAt     DateTime @default(now()) @map("extracted_at")

    normalized      WaterAnalysis?

    @@index([extractedAt])
    @@index([sourceFileHash])
    @@index([ahunterCleansedAt])
    @@index([aiVerified])
    @@index([geoLat, geoLon])
    @@index([geoSource])
    @@map("water_analysis_raw")
}

model WaterAnalysis {
    id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

    rawId           String   @unique @map("raw_id") @db.Uuid
    raw             WaterAnalysisRaw @relation(fields: [rawId], references: [id], onDelete: Cascade)

    orderNumber     String   @unique @map("order_number") @db.VarChar(32)
    sourceFileName  String   @map("source_file_name") @db.VarChar(512)

    // Каноничные значения после нормализации
    sampleDate      DateTime @map("sample_date") @db.Date
    testDate        DateTime? @map("test_date") @db.Date
    intakeType      WaterSourceType @map("intake_type")
    appearance      String?  @db.VarChar(256)

    // params:        { paramCode: number }                               — flat denorm payload
    // paramUnits:    { paramCode: string }                               — каноническая единица для каждого значения
    // paramFlags:    { paramCode: ('below_detection'|'above_limit'|...)[] } — особые случаи
    // paramsUnknown: { rawName: { valueRaw, unitRaw, reason } }            — для review/расширения PARAM_SYNONYMS
    // exceedsPdk вычисляется в runtime через @slovo/water-blank-extraction → exceedsPdk(paramCode, value).
    params          Json
    paramUnits      Json     @map("param_units")
    paramFlags      Json     @map("param_flags")
    paramsUnknown   Json     @map("params_unknown")

    // Адрес — каноническая форма (наследуется из WaterAnalysisRaw, после address-resolution pipeline)
    canonicalAddress String? @map("canonical_address") @db.VarChar(512)
    fiasId          String?  @map("fias_id") @db.VarChar(64)
    region          String?  @db.VarChar(128)
    district        String?  @db.VarChar(128)
    locality        String?  @db.VarChar(128)
    lat             Float?
    lon             Float?
    geoSource       WaterGeocodeSource? @map("geo_source")

    // PostGIS: GENERATED ALWAYS AS STORED — синхронизируется при INSERT/UPDATE из lat/lon.
    // Для radial-search через @slovo/water-blank-extraction в Этапе 2.
    geoPoint        Unsupported("geography(Point, 4326)")? @map("geo_point")

    // Из имени файла (после нормализации dealerLocation, без PII)
    dealerLocation  String?  @map("dealer_location") @db.VarChar(256)

    // Глубина источника (для скважин/колодцев). 55.7% бланков содержат, NULL для
    // централизованного водопровода (нерелевантно). Важна для подбора оборудования:
    // артезианская >100м vs верховодка <25м дают разный состав.
    depthMeters     Float?   @map("depth_meters")

    // Имя лаборатории (для аудита: одна лаборатория может систематически давать кривые значения).
    labName         String?  @map("lab_name") @db.VarChar(256)

    // NB: objectAddress / samplingPoint / conclusionText / customerNotes / notes
    // в derived НЕ переносим. Доступны через JOIN на water_analysis_raw.vision_payload по rawId
    // когда потребуется. Минимальный denorm — для часто фильтруемых/сортируемых полей.
    // См. memory `feedback_minimal_denorm` + ADR-005 (raw vs derived split).

    // Phase 2 — семантический поиск похожих анализов через Flowise Document Store
    // "water-analysis-aquaphor" (consistency с catalog-aquaphor паттерном, ADR-006).
    //
    // embedding_text — natural language description через generateEmbeddingText() (детерминированно).
    // Передаётся в Flowise loader как content, embedding хранится в Flowise-managed
    // таблице <docstoreId>_chunks (PostgresVectorStore с HNSW индексом).
    //
    // JOIN на chunks для combined geo+semantic queries:
    //   SELECT wa.*, ch.embedding <=> $q AS dist
    //   FROM water_analysis wa
    //   JOIN <docstoreId>_chunks ch ON ch.metadata->>'order_number' = wa.order_number
    //   WHERE ST_DWithin(wa.geo_point, $point, 5000)
    //   ORDER BY ch.embedding <=> $q LIMIT 10;
    embeddingText   String?  @map("embedding_text") @db.Text

    normalizationVersion String @map("normalization_version") @db.VarChar(16)
    normalizedAt    DateTime @default(now()) @map("normalized_at")

    @@index([region, district])
    @@index([sampleDate])
    @@index([intakeType])
    @@index([normalizationVersion])
    @@index([geoSource])
    @@map("water_analysis")
}

enum WaterSourceType {
    well        // скважина
    well_dug    // колодец
    municipal   // водопровод
    spring      // родник
    river       // открытый водоём
    other

    @@map("water_source_type")
}

// Этап 1.A.5 — verdict от Claude AI verify (auto-OK SQL + manual review).
// Защита от опечаток типа 'OK' vs 'ok' в downstream queries (tech-debt #21).
enum WaterAddressVerification {
    ok
    uncertain
    wrong

    @@map("water_address_verification")
}

// Этап 1.A.5 — точность матча от Ahunter /cleanse/address response.
// Значения PascalCase сохранены as-is из Ahunter API (не нормализуем).
enum WaterGeoLevel {
    Region
    District
    City
    Place
    Site
    Street

    @@map("water_geo_level")
}

// Этап 1.A.5 / dealer-median fallback — источник geo_lat/lon координат.
//   ahunter_cleanse — точные координаты из Ahunter /cleanse (happy path)
//   dealer_median   — fallback: median координат ok-records того же dealer'а
//   manual_override — manual lookup для top-dealers без геоинфы (#36)
enum WaterGeocodeSource {
    ahunter_cleanse
    dealer_median
    manual_override

    @@map("water_geocode_source")
}
