{
    "permissions": {
        "allow": [
            "Bash(git diff:*)",
            "Bash(git log:*)",
            "Bash(git show:*)",
            "Bash(git status)",
            "Bash(git status -s)",
            "Bash(git branch:*)",
            "Bash(git blame:*)",
            "Bash(git rev-parse:*)",
            "Bash(gh pr diff:*)",
            "Bash(gh pr view:*)",
            "Bash(gh pr list:*)",
            "Bash(gh api repos/:*)",
            "Bash(git check-ignore:*)",
            "Bash(npm view:*)",
            "Bash(npm outdated)",
            "Bash(npm ls:*)",
            "Bash(npm audit)",
            "Bash(npm audit --json)",
            "Bash(npm audit --production)"
        ]
    },
    "hooks": {
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node .claude/hooks/load-context.js"
                    }
                ]
            }
        ],
        "PreCompact": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node .claude/hooks/backup-transcript.js"
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "Bash|Read|Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.js\"",
                        "timeout": 10
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Write|Edit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/format.js\"",
                        "timeout": 30,
                        "statusMessage": "Formatting..."
                    }
                ]
            }
        ]
    }
}
