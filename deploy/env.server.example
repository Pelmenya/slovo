# === Application ===
NODE_ENV=development
API_PORT=3101
WORKER_CONCURRENCY=5
CORS_ORIGIN=https://separately-frames-handled-volunteer.trycloudflare.com
LOG_LEVEL=debug
TRUSTED_PROXY_HOPS=0

# === Build ===
NODE_IMAGE=dockerhub.timeweb.cloud/library/node:24.15-slim
SLOVO_IMAGE_TAG=dev

# === PostgreSQL ===
POSTGRES_HOST=slovo-postgres
POSTGRES_PORT=5433
POSTGRES_USER=slovo
POSTGRES_PASSWORD=change_me_slovo_postgres_password
POSTGRES_DB=slovo
DATABASE_URL=postgresql://slovo:change_me_slovo_postgres_password@slovo-postgres:5432/slovo?schema=public
SHADOW_DATABASE_URL=postgresql://slovo:change_me_slovo_postgres_password@slovo-postgres:5432/slovo_shadow?schema=public

# === Valkey / Redis ===
REDIS_HOST=slovo-valkey
REDIS_PORT=6380
REDIS_PASSWORD=change_me_slovo_redis_password

# === RabbitMQ ===
RABBITMQ_HOST=slovo-rabbitmq
RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673
RABBITMQ_USER=slovo
RABBITMQ_PASSWORD=change_me_slovo_rabbitmq_password
RABBITMQ_URL=amqp://slovo:change_me_slovo_rabbitmq_password@slovo-rabbitmq:5672

# === Flowise ===
FLOWISE_PORT=3130
FLOWISE_API_URL=http://slovo-flowise:3000
FLOWISE_API_KEY=

# === EU outbound proxy for Flowise -> OpenAI/Anthropic ===
EU_PROXY_URL=

# === S3 / Timeweb bucket shared with CRM catalog sync ===
S3_ENDPOINT=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=bf610397-aquaphor-pro-store
S3_CATALOG_BUCKET=bf610397-aquaphor-pro-store
S3_FORCE_PATH_STYLE=true
MINIO_PORT=9010
MINIO_CONSOLE_PORT=9011
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=unused_when_timeweb_s3_is_used

# === LLM providers ===
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-6
ANTHROPIC_FAST_MODEL=claude-haiku-4-5
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072
VISION_AUGMENTER_CHATFLOW_NAME=catalog-vision-augmenter-v1

# === Security / limits ===
JWT_SECRET=change_me_slovo_jwt_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
THROTTLE_TTL=60
THROTTLE_LIMIT=100
VISION_BUDGET_DAILY_USD=5
EMBEDDING_BUDGET_DAILY_USD=1

# === Optional services ===
AHUNTER_HOST=http://ahunter.ru/site
AHUNTER_API_KEY=
LANGFUSE_ENABLED=false
LANGFUSE_PORT=3100
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
LANGFUSE_POSTGRES_PORT=5434
LANGFUSE_POSTGRES_USER=langfuse
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_POSTGRES_DB=langfuse
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@slovo.local
PGADMIN_DEFAULT_PASSWORD=admin
REDIS_COMMANDER_PORT=8081
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_IDS=
TELEGRAM_ALERTS_ENABLED=false
